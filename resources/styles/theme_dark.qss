QWidget {
    background-color: #1e1e1e;
    color: #f0f0f0;
    font-family: "Segoe UI", sans-serif;
}

QLineEdit {
    background-color: #2b2b2b;
    color: #ffffff;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 4px 8px;
    selection-background-color: #ff9800;
}

QLabel {
    background-color: transparent;
    color: #b0b0b0;
}

QPushButton {
    background-color: #2d2d2d;
    color: #f0f0f0;
    border: 1px solid #3c3c3c;
    border-radius: 6px;
}

QPushButton:hover {
    background-color: #3a3a3a;
}

QPushButton:pressed {
    background-color: #252525;
}

QPushButton#EqualsButton {
    background-color: #ff9800;
    color: #1e1e1e;
    border: 1px solid #ff9800;
    font-weight: bold;
}

QPushButton#EqualsButton:hover {
    background-color: #ffa726;
}

QPushButton#EqualsButton:pressed {
    background-color: #f57c00;
}

QToolButton {
    background-color: transparent;
    border: none;
}

QToolButton:hover {
    background-color: #2d2d2d;
    border-radius: 4px;
}

QComboBox {
    background-color: #2b2b2b;
    color: #f0f0f0;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 3px 6px;
}

QComboBox QAbstractItemView {
    background-color: #2b2b2b;
    color: #f0f0f0;
    selection-background-color: #ff9800;
    selection-color: #1e1e1e;
}

QSpinBox {
    background-color: #2b2b2b;
    color: #f0f0f0;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 2px 4px;
}

QSlider::groove:horizontal {
    height: 4px;
    background: #3c3c3c;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #ff9800;
    width: 14px;
    margin: -6px 0;
    border-radius: 7px;
}

QSlider::sub-page:horizontal {
    background: #ff9800;
    border-radius: 2px;
}
